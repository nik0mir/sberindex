set -u
R="$(cd "$(dirname "$0")" && pwd)"
export PYTHONIOENCODING=utf-8
export UV_CACHE_DIR="$R/uvcache"
ts() { date '+%Y-%m-%d %H:%M:%S'; }
echo "START $(ts)"
cd "$R/copy" || exit 1
git log --oneline -1
start=$(date +%s)
uv run --frozen --offline python -m munnet all > ../run2.log 2>&1; echo "ALL_EXIT=$? seconds=$(( $(date +%s) - start )) $(ts)"
git status --short > ../git_status_after.txt
echo "DONE $(ts)"
