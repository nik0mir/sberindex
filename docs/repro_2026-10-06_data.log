## run_data.sh
#!/usr/bin/env bash
# Проверка этапа data с пустой data/raw (06.10.2026): свежая копия HEAD, скачивание из источников по README (Windows).
set -u
R="$(cd "$(dirname "$0")" && pwd)"
SRC="C:/Users/1/Desktop/sberindex"
PY="C:/Users/1/AppData/Roaming/uv/python/cpython-3.12.14-windows-x86_64-none/python.exe"
export PYTHONIOENCODING=utf-8
ts() { date '+%Y-%m-%d %H:%M:%S'; }
echo "START $(ts)"
cd "$R" || exit 1
rm -rf copy
git clone --no-hardlinks --branch claude/agents-panel-eda "$SRC" copy > clone.log 2>&1; echo "CLONE_EXIT=$? $(ts)"
cd copy || exit 1
git log --oneline -1
start=$(date +%s)
uv sync --frozen --python "$PY" > ../uvsync.log 2>&1; echo "UVSYNC_EXIT=$? seconds=$(( $(date +%s) - start )) $(ts)"
ls data 2>/dev/null; echo "DATA_DIR_BEFORE: $(ls -A data 2>/dev/null | wc -l) entries"
# 1. Этап data с пустой data/raw (README: uv run --frozen python -m munnet data)
start=$(date +%s)
uv run --frozen python -m munnet data > ../data1.log 2>&1; echo "DATA1_EXIT=$? seconds=$(( $(date +%s) - start )) $(ts)"
tail -5 ../data1.log
# 2. README, раздел «Windows»: распаковать RAR встроенным tar.exe, записать метку, повторить data
if [ -f data/raw/borders/t_dict_municipal.rar ] && [ ! -f data/raw/borders/.extracted_sha256 ]; then
  /c/Windows/System32/tar.exe -xf data/raw/borders/t_dict_municipal.rar -C data/raw/borders; echo "TAR_EXIT=$? $(ts)"
  printf %s 319ed22684b77716641bc15b61f7325adc44e9fc47e9be2973d88412d27d21f5 > data/raw/borders/.extracted_sha256
  start=$(date +%s)
  uv run --frozen python -m munnet data > ../data2.log 2>&1; echo "DATA2_EXIT=$? seconds=$(( $(date +%s) - start )) $(ts)"
  tail -5 ../data2.log
fi
du -sh data/raw; find data/raw -type f | wc -l
# 3. Контроль: лёгкие этапы panel и features на свежескачанных данных
start=$(date +%s)
uv run --frozen python -m munnet panel features > ../panel.log 2>&1; echo "PANEL_FEATURES_EXIT=$? seconds=$(( $(date +%s) - start )) $(ts)"
git status --short > ../git_status_after.txt
echo "DONE $(ts)"
