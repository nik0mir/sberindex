## run.sh (первая часть)
#!/usr/bin/env bash
# Прогон с нуля 06–07.10.2026: чистая копия HEAD, uv sync с пустым кэшем, pytest, munnet all (с data).
set -u
R="C:/Users/1/AppData/Local/Temp/claude/C--Users-1-Desktop-sberindex/bcd40b4a-f816-4cf8-a99e-31dab84a25d9/scratchpad/w0510/repro_0610"
SRC="C:/Users/1/Desktop/sberindex"
PY="C:/Users/1/AppData/Roaming/uv/python/cpython-3.12.14-windows-x86_64-none/python.exe"
export PYTHONIOENCODING=utf-8
ts() { date '+%Y-%m-%d %H:%M:%S'; }
echo "START $(ts)"
cd "$R" || exit 1
rm -rf copy uvcache
git clone --no-hardlinks --branch claude/agents-panel-eda "$SRC" copy > clone.log 2>&1; echo "CLONE_EXIT=$? $(ts)"
cd copy || exit 1
git log --oneline -1
export UV_CACHE_DIR="$R/uvcache"
start=$(date +%s)
uv sync --frozen --python "$PY" > ../uvsync.log 2>&1; echo "UVSYNC_EXIT=$? seconds=$(( $(date +%s) - start )) $(ts)"
start=$(date +%s)
HTTPS_PROXY=http://127.0.0.1:9 HTTP_PROXY=http://127.0.0.1:9 uv run --frozen --offline pytest -q -p no:cacheprovider > ../pytest.log 2>&1; echo "PYTEST_EXIT=$? seconds=$(( $(date +%s) - start )) $(ts)"
tail -3 ../pytest.log
uv run --frozen --offline ruff check . > ../ruff.log 2>&1; echo "RUFF_EXIT=$?"
uv run --frozen --offline ruff format --check . >> ../ruff.log 2>&1; echo "RUFF_FMT_EXIT=$?"
mkdir -p data
cp -r "$SRC/data/raw" data/raw; echo "RAW_COPIED $(ts)"
start=$(date +%s)
uv run --frozen --offline python -m munnet all > ../run.log 2>&1; echo "ALL_EXIT=$? seconds=$(( $(date +%s) - start )) $(ts)"
git status --short > ../git_status_after.txt
echo "DONE $(ts)"
## run_resume.sh (вторая часть; перед запуском в копии удалены outputs/, data/interim, data/processed и восстановлен docs/eda.md: git status был чистым)
#!/usr/bin/env bash
# Повтор прогона с нуля (продолжение 06.10): чистая копия уже есть в copy/ (коммит 3b07cae), окружение и тесты прошли.
